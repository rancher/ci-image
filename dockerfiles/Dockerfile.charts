    printf "%s  %s\n" "${CHECKSUM}" "${TMP_DIR}/kubectl1.32" > "${TMP_DIR}/checksum.sha256" && \
    sha256sum -c "${TMP_DIR}/checksum.sha256" && \
    install "${TMP_DIR}/kubectl1.32" "/usr/local/bin/kubectl1.32" && \
    rm -rf "${TMP_DIR}"

# kubectl1.33 v1.33.13
RUN case "${ARCH}" in \
        amd64) CHECKSUM="316d712726d857c20744c57cb36aa47cfc79bc0af7e82cebf3780244b654c073" ;; \
        arm64) CHECKSUM="9fe8aadd5aab9421978c7ac95de6fad304a3c4c0ce9dbf4127579779e0699080" ;; \
        *) echo "Unsupported: ${ARCH}"; exit 1 ;; \
    esac && \
    export TMP_DIR=$(mktemp -d) && \
