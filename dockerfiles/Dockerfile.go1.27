        amd64) DOWNLOAD_URL="https://github.com/cli/cli/releases/download/v2.103.3/gh_2.103.3_linux_amd64.tar.gz"; EXTRACT="gh_2.103.3_linux_amd64/bin/gh" ;; \
        arm64) DOWNLOAD_URL="https://github.com/cli/cli/releases/download/v2.103.3/gh_2.103.3_linux_arm64.tar.gz"; EXTRACT="gh_2.103.3_linux_arm64/bin/gh" ;; \
