    case "${ARCH}" in \
        amd64) DOWNLOAD_URL="https://dl.k8s.io/release/v1.34.10/bin/linux/amd64/kubectl" ;; \
        arm64) DOWNLOAD_URL="https://dl.k8s.io/release/v1.34.10/bin/linux/arm64/kubectl" ;; \
    esac && \
    curl -fsSL --retry 3 --retry-delay 5 --retry-all-errors "${DOWNLOAD_URL}" > "${TMP_DIR}/kubectl1.34" && \
    printf "%s  %s\n" "${CHECKSUM}" "${TMP_DIR}/kubectl1.34" > "${TMP_DIR}/checksum.sha256" && \
    sha256sum -c "${TMP_DIR}/checksum.sha256" && \
    install "${TMP_DIR}/kubectl1.34" "/usr/local/bin/kubectl1.34" && \
    rm -rf "${TMP_DIR}"

# kubectl1.35 v1.35.7
RUN case "${ARCH}" in \
        amd64) CHECKSUM="12e97f9d23a9f6cbb87b89becd6bd291e1a858a3379a4e11e2c822c4c1530052" ;; \
        arm64) CHECKSUM="5103d45b8881434d417694057b8ccb5ae79fd310a5c5c13e403c5e62e15909be" ;; \
        *) echo "Unsupported: ${ARCH}"; exit 1 ;; \
    esac && \
    export TMP_DIR=$(mktemp -d) && \
    case "${ARCH}" in \
        amd64) DOWNLOAD_URL="https://dl.k8s.io/release/v1.35.7/bin/linux/amd64/kubectl" ;; \
        arm64) DOWNLOAD_URL="https://dl.k8s.io/release/v1.35.7/bin/linux/arm64/kubectl" ;; \
    esac && \
    curl -fsSL --retry 3 --retry-delay 5 --retry-all-errors "${DOWNLOAD_URL}" > "${TMP_DIR}/kubectl1.35" && \
    printf "%s  %s\n" "${CHECKSUM}" "${TMP_DIR}/kubectl1.35" > "${TMP_DIR}/checksum.sha256" && \
    sha256sum -c "${TMP_DIR}/checksum.sha256" && \
    install "${TMP_DIR}/kubectl1.35" "/usr/local/bin/kubectl1.35" && \
    rm -rf "${TMP_DIR}"

# kubectl1.36 v1.36.3
RUN case "${ARCH}" in \
        amd64) CHECKSUM="ebbd080e7c2e275093b55915722043257eb24004363e20acb3c4d71919f88336" ;; \
        arm64) CHECKSUM="3d86f24401c41ae5a46ac50eef8865fe891d3647d324a0836f6c63757a126e62" ;; \
        *) echo "Unsupported: ${ARCH}"; exit 1 ;; \
    esac && \
    export TMP_DIR=$(mktemp -d) && \
    case "${ARCH}" in \
        amd64) DOWNLOAD_URL="https://dl.k8s.io/release/v1.36.3/bin/linux/amd64/kubectl" ;; \
        arm64) DOWNLOAD_URL="https://dl.k8s.io/release/v1.36.3/bin/linux/arm64/kubectl" ;; \
    esac && \
    curl -fsSL --retry 3 --retry-delay 5 --retry-all-errors "${DOWNLOAD_URL}" > "${TMP_DIR}/kubectl1.36" && \
    printf "%s  %s\n" "${CHECKSUM}" "${TMP_DIR}/kubectl1.36" > "${TMP_DIR}/checksum.sha256" && \
    sha256sum -c "${TMP_DIR}/checksum.sha256" && \
    install "${TMP_DIR}/kubectl1.36" "/usr/local/bin/kubectl1.36" && \
    rm -rf "${TMP_DIR}"

# Family selectors — copy scripts and set up manifest + active symlinks.
# /var/ci-tools/active is on PATH ahead of /usr/local/bin; runner can update
# the active symlink with: ci-select <family> <tool>  or  select-<family> <tool>
COPY dockerfiles/scripts/select-helm.sh /usr/local/bin/select-helm
COPY dockerfiles/scripts/select-kubectl.sh /usr/local/bin/select-kubectl
COPY dockerfiles/scripts/ci-select.sh /usr/local/bin/ci-select
COPY dockerfiles/scripts/ci-env-init.sh /usr/local/bin/ci-env-init
RUN chmod +x /usr/local/bin/select-helm && chmod +x /usr/local/bin/select-kubectl && chmod +x /usr/local/bin/ci-select && \
    chmod +x /usr/local/bin/ci-env-init

# Aliases
RUN ln -sf /usr/local/bin/helmv3 /usr/local/bin/helm_v3

# Cleanup Go caches
RUN go clean -cache -modcache


# Set up CI tool family infrastructure (runner user and group created earlier).
RUN mkdir -p /var/ci-tools/active \
    && mkdir -p /usr/local/share/ci-tools/families/helm \
    && touch /usr/local/share/ci-tools/families/helm/helmv3 \
    && touch /usr/local/share/ci-tools/families/helm/helmv4 \
    && ln -sf helmv4 /usr/local/share/ci-tools/families/helm/default \
    && ln -sf /usr/local/bin/helmv4 /var/ci-tools/active/helm \
    && mkdir -p /usr/local/share/ci-tools/families/kubectl \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.28 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.29 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.30 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.31 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.32 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.33 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.34 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.35 \
    && touch /usr/local/share/ci-tools/families/kubectl/kubectl1.36 \
    && touch /usr/local/share/ci-tools/families/kubectl/kuberlr \
    && ln -sf kubectl1.36 /usr/local/share/ci-tools/families/kubectl/default \
    && ln -sf /usr/local/bin/kubectl1.36 /var/ci-tools/active/kubectl \
    && chown -R root:runner /var/ci-tools \
    && chmod 2775 /var/ci-tools/active

# We trust our base image and the repos that are pulled in workflows. Otherwise
# each workflow that uses our base images would have to add the step below.
RUN git config --system --add safe.directory '*'

# Auto-configure tool families from {FAMILY}_VERSION env vars, then exec user command.
# Users can set HELM_VERSION=helmv4 to auto-select helmv4 as the active helm tool.
ENTRYPOINT ["ci-env-init"]
CMD ["/bin/bash"]
